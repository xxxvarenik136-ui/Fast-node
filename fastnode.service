[Unit]
Description=FastNode - ensure CLI aliases are available

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if [ ! -L %h/.local/bin/wfnode ]; then ln -sf %h/.local/bin/fastnode.py %h/.local/bin/wfnode; fi; if [ ! -L %h/.local/bin/fnode ]; then ln -sf %h/.local/bin/fastnode.py %h/.local/bin/fnode; fi; if [ ! -L %h/.local/bin/dfnode ]; then ln -sf %h/.local/bin/fastnode.py %h/.local/bin/dfnode; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target